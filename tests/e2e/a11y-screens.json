{
  "$comment": "Screens tests/e2e/a11y.spec.js checks with axe-core. This file belongs to the plugin: apply-template.py only writes it when it is missing. The fields are described in docs/DEVELOPMENT.md.",
  "include": ["#wpbody-content"],
  "exclude": [],
  "screens": [
    {
      "name": "Tools > Activity Log, empty",
      "setup": [["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"]],
      "url": "/wp-admin/tools.php?page=activity-log-with-undo"
    },
    {
      "name": "Tools > Activity Log with changes",
      "setup": [
        ["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"],
        { "wp": ["post", "create", "--post_title=Lemon tart", "--post_status=publish", "--post_content=A short pastry case and a sharp lemon curd.", "--porcelain", "--user=admin"], "save": "post" },
        ["post", "update", "{post}", "--post_content=A short pastry case, a sharp lemon curd and burnt sugar on top.", "--user=admin"],
        ["option", "update", "blogname", "Kitchen Notes", "--user=admin"],
        ["post", "delete", "{post}", "--user=admin"]
      ],
      "url": "/wp-admin/tools.php?page=activity-log-with-undo",
      "cleanup": [
        ["post", "delete", "{post}", "--force"],
        ["option", "update", "blogname", "E2E"],
        ["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"]
      ]
    },
    {
      "name": "One change with its before and after values",
      "setup": [
        ["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"],
        { "wp": ["post", "create", "--post_title=Lemon tart", "--post_status=publish", "--post_content=A short pastry case and a sharp lemon curd.", "--porcelain", "--user=admin"], "save": "post" },
        ["post", "update", "{post}", "--post_content=A short pastry case, a sharp lemon curd and burnt sugar on top.", "--user=admin"],
        { "wp": ["activity-log-with-undo", "list", "--event=post_updated", "--per-page=1", "--format=ids"], "save": "entry" }
      ],
      "url": "/wp-admin/tools.php?page=activity-log-with-undo&entry={entry}",
      "cleanup": [
        ["post", "delete", "{post}", "--force"],
        ["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"]
      ]
    },
    {
      "name": "A change made again since, with Undo anyway",
      "setup": [
        ["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"],
        ["option", "update", "blogname", "Kitchen Notes Weekly", "--user=admin"],
        { "wp": ["activity-log-with-undo", "list", "--event=option_updated", "--per-page=1", "--format=ids"], "save": "entry" },
        ["option", "update", "blogname", "Kitchen Notes", "--user=admin"]
      ],
      "url": "/wp-admin/tools.php?page=activity-log-with-undo&entry={entry}",
      "steps": [{ "waitFor": ".alu-conflict" }],
      "cleanup": [
        ["option", "update", "blogname", "E2E"],
        ["eval", "AryanX\\ActivityLogWithUndo\\Plugin::instance()->store()->truncate();"]
      ]
    },
    {
      "name": "Tools > Activity Log settings",
      "url": "/wp-admin/tools.php?page=activity-log-with-undo&tab=settings"
    }
  ],
  "skip": {}
}
