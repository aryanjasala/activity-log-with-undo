{
  "name": "aryanx/activity-log-with-undo",
  "description": "An activity log where every change you can reverse has an Undo button.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Aryan Jasala",
      "homepage": "https://profiles.wordpress.org/aryanjasala/"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "brain/monkey": "^2.7",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "AryanX\\Axle\\ActivityLogWithUndo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AryanX\\Axle\\ActivityLogWithUndo\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit"
  }
}
